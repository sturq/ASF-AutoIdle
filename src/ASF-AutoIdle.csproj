<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ASF-AutoIdle plugin.
    Plugins must be compiled against the ArchiSteamFarm.dll that ships with
    your ASF install. This csproj reads the path from an ASF_DIR env var or
    the sibling ASF folder. Target framework must match your ASF runtime
    TFM (net10.0 for ASF 6.3.x main).
  -->

  <PropertyGroup>
    <AssemblyName>ASF-AutoIdle</AssemblyName>
    <RootNamespace>ASF.AutoIdle</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.18.0</Version>
    <Authors>sturq</Authors>
    <Description>ArchiSteamFarm plugin that auto-detects every owned game and idles them in rotating batches of 32 so all games gain hours evenly.</Description>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ASF_DIR Condition=" '$(ASF_DIR)' == '' ">$(MSBuildThisFileDirectory)..\ASF</ASF_DIR>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ArchiSteamFarm">
      <HintPath>$(ASF_DIR)\ArchiSteamFarm.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SteamKit2">
      <HintPath>$(ASF_DIR)\SteamKit2.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Required so [Export(typeof(IPlugin))] resolves at compile time. -->
    <PackageReference Include="System.Composition.AttributedModel" Version="10.0.0" IncludeAssets="compile" />
  </ItemGroup>

</Project>
